# LinX Cloudflare Pages Redirects
# SPA-style fallback for direct URL access

# Admin redirect
/admin          /admin/index.html  302

# Retire the legacy www destination and preserve a clear white-label URL.
/linxservices.ca   /white-label/   301
/linxservices.ca/  /white-label/   301

# API and SMS workers pass-through (served by Cloudflare Workers, not Pages)
# These routes are handled by DNS routing to worker subdomains
# api.linxservices.ca → api.js Worker
# sms.linxservices.ca → sms.js Worker
# ai.linxservices.ca  → ai-gateway.js Worker

# Branded short links are resolved by the API Worker and then redirect to their stored destination.
/r/*  https://api.linxservices.ca/r/:splat  200
