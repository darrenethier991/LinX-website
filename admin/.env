# ─── Google Sheets API ──────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com
# 2. Create a project (or select an existing one)
# 3. Enable the "Google Sheets API" for that project
# 4. Go to IAM & Admin → Service Accounts → Create Service Account
# 5. Generate a JSON key for the service account and download it
# 6. Copy "client_email" from the JSON  → GOOGLE_SERVICE_ACCOUNT_EMAIL below
# 7. Copy "private_key"  from the JSON  → GOOGLE_PRIVATE_KEY below
#    (keep the surrounding double-quotes; the \n sequences are real newlines)
# 8. Open each Google Sheet, click Share, and give the service account
#    email address Editor access — otherwise API calls will return 403
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Google Sheets IDs ──────────────────────────────────────────────────────
# The Sheet ID is the long string in the URL:
#   docs.google.com/spreadsheets/d/<SHEET_ID>/edit
HOMEOWNER_SHEET_ID=
CONTRACTOR_SHEET_ID=

# ─── LinX Services API ──────────────────────────────────────────────────────
LINX_API_BASE_URL=https://api.linxservices.ca
LINX_API_KEY=

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ─── Security (optional) ────────────────────────────────────────────────────
# Comma-separated list of allowed IP addresses.
# Leave empty (or remove entirely) to allow all IPs.
# Example: IP_WHITELIST=203.0.113.10,198.51.100.42
IP_WHITELIST=

# Comma-separated list of webhook URLs for outbound event notifications.
# Webhooks receive a JSON POST for every new lead delivered to a contractor.
# Can be used to forward to SMS gateways (Twilio Functions), Slack, Zapier, etc.
# Example: WEBHOOK_URLS=https://hooks.slack.com/...,https://your-app.com/hook
WEBHOOK_URLS=

# ─── Lead Crawler ────────────────────────────────────────────────────────────
# Set to "true" to automatically start the crawler scheduler on server boot.
CRAWLER_AUTO_START=false

# How often the crawler runs (milliseconds). Default: 4 hours (14400000).
CRAWL_INTERVAL_MS=14400000

# Polite delay between requests within a single crawl cycle (ms). Default: 3000.
CRAWL_DELAY_MS=3000

# Request timeout per URL (ms). Default: 15000.
CRAWL_TIMEOUT_MS=15000

# How long a lead is considered "fresh" (hours). Default: 72.
LEAD_FRESHNESS_HOURS=72

# Public URL of the contractor lead board (embedded in notification emails).
LEAD_BOARD_URL=https://linxservices.ca/contractor-leads.html

# ─── SMTP (optional — required for email notifications) ──────────────────────
# Leave SMTP_HOST empty to disable email notifications.
# Example values for Gmail SMTP relay:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=leads@linxservices.ca
