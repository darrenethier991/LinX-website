{
  "name": "linx-admin-server",
  "version": "2.0.0",
  "description": "LinX Admin Dashboard Backend Server + Lead Pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "crawler": "node -e \"require('./leads/crawler').start([])\"",
    "generate-hash": "node -e \"const b=require('bcryptjs');const p=process.argv[1];b.hash(p,12).then(h=>{console.log('\\nPassword hash for .env:\\n');console.log(h);console.log()})\"",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
    "generate-sha256": "node -e \"const c=require('crypto');const p=process.argv[1];console.log('SHA-256 (for Worker ADMIN_PASSWORD_HASH):');console.log(c.createHash('sha256').update(p).digest('hex'))\"",
    "test:classify": "node -e \"const {classifyLead}=require('./leads/classifier');console.log(classifyLead('need a plumber to fix leaking pipe under sink'))\"",
    "test:dedupe": "node -e \"const {isDuplicate,buildHash}=require('./leads/deduplicator');const a={title:'Fix my roof',description:'shingle damage',sourceUrl:'http://a.com',city:'Toronto'};console.log(isDuplicate({...a,contentHash:buildHash(a)},[{...a,contentHash:buildHash(a),status:'active'}]))\"",
    "worker:dev": "cd .. && wrangler dev",
    "worker:deploy": "cd .. && wrangler deploy",
    "worker:db:migrate": "cd .. && wrangler d1 migrations apply linx-db --remote",
    "worker:db:migrate:local": "cd .. && wrangler d1 migrations apply linx-db --local",
    "pages:deploy": "npm run build && cd .. && wrangler pages deploy admin/dist --project-name linx-dashboard"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.11.0",
    "googleapis": "^140.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "nodemon": "^3.1.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
