{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linx-api",
  "main": "workers/api/index.js",
  "compatibility_date": "2025-01-01",

  // ── Required for Wrangler v4+ ─────────────────────────────────────────────
  "account_id": "REPLACE_WITH_YOUR_CF_ACCOUNT_ID",

  // ── Non-secret vars (safe to commit) ──────────────────────────────────────
  "vars": {
    "ADMIN_USERNAME": "admin"
  },

  // ── D1 database (modern format) ───────────────────────────────────────────
  "d1_databases": {
    "DB": {
      "database_name": "linx-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "./workers/migrations"
    }
  },

  // ── Observability ─────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  }
}

