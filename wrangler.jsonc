{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linx-api",
  "main": "workers/api/index.js",
  "compatibility_date": "2025-01-01",

  // ── Non-secret vars (safe to commit) ──────────────────────────────────────
  "vars": {
    "ADMIN_USERNAME": "admin"
    // ADMIN_PASSWORD_HASH and JWT_SECRET are secrets — set via:
    //   wrangler secret put ADMIN_PASSWORD_HASH
    //   wrangler secret put JWT_SECRET
    //
    // Generate ADMIN_PASSWORD_HASH (SHA-256 of your password):
    //   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
    //
    // Generate JWT_SECRET (64 random hex bytes):
    //   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
  },

  // ── D1 database ────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linx-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "./workers/migrations"
    }
  ],

  // ── Observability ──────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  }
}
